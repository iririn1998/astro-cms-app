---
import { getCollection } from "astro:content";

import PostCard from "../components/PostCard.astro";
import Layout from "../layouts/Layout.astro";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((post) => post.data.draft !== true)
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="ノート日和"
  description="日々のメモや考えをまとめるブログです。"
>
  <section class="mx-auto max-w-6xl px-5 py-12 md:px-8 md:py-16">
    <header class="max-w-3xl">
      <h1 class="mt-3 text-4xl font-bold text-zinc-950 md:text-6xl">ノート日和</h1>
      <p class="mt-5 text-lg leading-8 text-zinc-600">
        日々のメモや考えをまとめるブログです。
      </p>
    </header>

    {
      posts.length > 0 ? (
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-10 rounded-lg border border-zinc-200 bg-white p-5 text-zinc-600">
          公開中の記事はまだありません。
        </p>
      )
    }
  </section>
</Layout>
