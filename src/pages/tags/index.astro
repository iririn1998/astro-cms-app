---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";

const allPosts = await getCollection("blog");
const posts = allPosts.filter((post) => post.data.draft !== true);
const tagCounts = posts.reduce((counts, post) => {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }

  return counts;
}, new Map<string, number>());
const tags = [...tagCounts.entries()].sort(([a], [b]) => a.localeCompare(b, "ja"));
---

<Layout title="Tags | Astro CMS Blog" description="記事タグの一覧です。">
  <section class="mx-auto max-w-6xl px-5 py-12 md:px-8 md:py-16">
    <header>
      <p class="text-sm font-semibold text-cyan-700">Tags</p>
      <h1 class="mt-3 text-4xl font-bold text-zinc-950 md:text-5xl">タグ一覧</h1>
    </header>

    {
      tags.length > 0 ? (
        <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {tags.map(([tag, count]) => (
            <li>
              <a
                class="flex items-center justify-between rounded-lg border border-zinc-200 bg-white px-5 py-4 shadow-sm hover:border-cyan-300"
                href={`/tags/${encodeURIComponent(tag)}/`}
              >
                <span class="font-medium text-zinc-950">#{tag}</span>
                <span class="text-sm text-zinc-500">{count} posts</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-10 rounded-lg border border-zinc-200 bg-white p-5 text-zinc-600">
          タグ付きの記事はまだありません。
        </p>
      )
    }
  </section>
</Layout>
