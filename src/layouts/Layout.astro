---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "ノート日和",
  description = "Markdown files powered by Astro Content Collections.",
} = Astro.props;
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-950 antialiased">
    <div class="min-h-screen border-t-4 border-cyan-500">
      <header class="border-b border-zinc-200 bg-white/90 backdrop-blur">
        <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 md:px-8">
          <a href="/" class="text-base font-semibold text-zinc-950">ノート日和</a>
          <div class="flex items-center gap-1 text-sm font-medium">
            <a class="rounded-md px-3 py-2 text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950" href="/">
              Home
            </a>
            <a
              class="rounded-md px-3 py-2 text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950"
              href="/tags/"
            >
              Tags
            </a>
          </div>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="border-t border-zinc-200">
        <div class="mx-auto max-w-6xl px-5 py-8 text-sm text-zinc-500 md:px-8">
          Markdown powered by Astro Content Collections.
        </div>
      </footer>
    </div>
  </body>
</html>
